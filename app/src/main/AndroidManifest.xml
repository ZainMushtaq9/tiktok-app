<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReelStack">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ReelStack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Programmatic SEO Deep Link Routes -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="reelstack.com" />
                <data android:path="/download-tiktok-no-watermark" />
                <data android:path="/tiktok-profile-downloader" />
                <data android:path="/tiktok-mp3-downloader" />
                <data android:path="/instagram-reels-downloader" />
                <data android:path="/instagram-profile-downloader" />
                <data android:path="/facebook-video-downloader" />
                <data android:path="/youtube-shorts-downloader" />
            </intent-filter>
        </activity>
    </application>

</manifest>
